Algoritmo "Matrizes"



Var

  Tabela: Vetor[1..2, 1..2] De Inteiro
  
  linha, coluna: Inteiro
  
Inicio

  
  Para linha <- 1 Ate 2 faca
    Para coluna <- 1 Ate 2 faca
      leia (Tabela[linha, coluna])
      
    Fimpara
    
  Fimpara
  
  Para linha <- 1 Ate 2 Faca
    Para coluna <- 1 Ate 2 Faca
      Escreval(Tabela[linha, coluna])
      
    FimPara
    
  FimPara
  
Fimalgoritmo
